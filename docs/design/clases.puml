@startuml clases
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Liberation Sans", Arial, sans-serif
skinparam classBackgroundColor #F4F7FB
skinparam classBorderColor #1A3A5C
skinparam classHeaderBackgroundColor #E2EAF4
skinparam interfaceBackgroundColor #FFF8E7
skinparam interfaceBorderColor #B26B00
skinparam enumBackgroundColor #F3E5F5
skinparam enumBorderColor #6A1B9A

title SismoReporta AQP — Diagrama de Clases Refactorizado hacia Patrones GoF (Lab 07)

class Coordenadas <<ValueObject>> {
  - latitud: Decimal
  - longitud: Decimal
  + estaDentroDeGeocerca(): bool
}

class Reporte <<Context>> {
  - id: UUID
  - fechaSincronizacion: DateTime
  - descripcion: String
  - severidad: String
  - _estado: EstadoReporteState
  + estado: String
  + cambiar_estado(nuevo: EstadoReporteState): void
  + encolar_offline(): void
  + sincronizar(fecha: DateTime): void
  + verificar_triaje(scorePrioridad: Decimal): void
  + atender_incidente(): void
  + descartar(motivo: String): void
}

abstract class EstadoReporteState <<State>> {
  + {static} nombre: String
  + encolar_offline(r: Reporte): void
  + sincronizar(r: Reporte, fecha: DateTime): void
  + verificar_triaje(r: Reporte, score: Decimal): void
  + atender_incidente(r: Reporte): void
  + descartar(r: Reporte, motivo: String): void
}

class BorradorState <<ConcreteState>>
class EncoladoState <<ConcreteState>>
class RecibidoState <<ConcreteState>>
class VerificadoState <<ConcreteState>>
class AtendidoState <<ConcreteState>>
class DescartadoState <<ConcreteState>>

EstadoReporteState <|-- BorradorState
EstadoReporteState <|-- EncoladoState
EstadoReporteState <|-- RecibidoState
EstadoReporteState <|-- VerificadoState
EstadoReporteState <|-- AtendidoState
EstadoReporteState <|-- DescartadoState
Reporte o--> EstadoReporteState : "delega a"

interface ICanalDespacho <<Strategy>> {
  + despachar(reporte_id: String, descripcion: String): ResultadoDespacho
}

class ConReintentos <<Decorator>> {
  - _interno: ICanalDespacho
  - _intentos: int
  + despachar(reporte_id: String, descripcion: String): ResultadoDespacho
}

class FabricaCanales <<Factory>> {
  + registrar(nombre: String, creador: Callable): void
  + crear(nombre: String): ICanalDespacho
}

class RedisCanalAdapter <<Adapter>>
class RabbitMQCanalAdapter <<Adapter>>
class SmsSatelitalCanalAdapter <<Adapter>>

ICanalDespacho <|.. ConReintentos
ICanalDespacho <|.. RedisCanalAdapter
ICanalDespacho <|.. RabbitMQCanalAdapter
ICanalDespacho <|.. SmsSatelitalCanalAdapter
ConReintentos o--> ICanalDespacho : "decora"
FabricaCanales ..> ICanalDespacho : "instancia"

class PublicadorEventos <<Subject>> {
  + suscribir(tipo: String, suscriptor: Suscriptor): void
  + publicar(tipo: String, datos: Dict): void
}

interface Suscriptor <<Observer>> {
  + actualizar(tipo: String, datos: Dict): void
}

class NotificadorCOE <<ConcreteObserver>>
class AuditorEventosSismicos <<ConcreteObserver>>

Suscriptor <|.. NotificadorCOE
Suscriptor <|.. AuditorEventosSismicos
PublicadorEventos o--> Suscriptor : "notifica a"

class ClasificadorSeveridadIA {
  - proveedor: ProveedorLLM
  - guardrails: Guardrail
  + clasificar(descripcion: String): String
}

interface ProveedorLLM <<Strategy>> {
  + completar(prompt: String): String
}

class ConCacheLLM <<Decorator>>
class ClienteLLMAdapter <<Adapter>>
abstract class Guardrail <<ChainOfResponsibility>> {
  - _siguiente: Guardrail
  + validar(texto: String): String
}

ProveedorLLM <|.. ClienteLLMAdapter
ProveedorLLM <|.. ConCacheLLM
ClasificadorSeveridadIA --> ProveedorLLM
ClasificadorSeveridadIA --> Guardrail

class ServicioSincronizacion <<Service>> {
  - fabrica: FabricaCanales
  - publicador: PublicadorEventos
  - clasificador_ia: ClasificadorSeveridadIA
  + sincronizar_reporte(reporte: Reporte, canal: String): String
  + clasificar_severidad_con_ia(descripcion: String): String
}

ServicioSincronizacion ..> Reporte : "orquesta"
ServicioSincronizacion --> FabricaCanales : "resuelve canal"
ServicioSincronizacion --> PublicadorEventos : "emite eventos"
ServicioSincronizacion --> ClasificadorSeveridadIA : "clasifica daños"

@enduml
