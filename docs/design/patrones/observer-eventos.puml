@startuml observer-eventos
skinparam monochrome false
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName "Liberation Sans", Arial, sans-serif
skinparam classFontSize 10
skinparam roundCorner 6

title SismoReporta AQP — Patrón Observer (Publicación y Suscripción de Eventos)

class PublicadorEventos <<Subject>> {
  - _suscriptores: Dict[str, List[Suscriptor]]
  + suscribir(tipo_evento: str, suscriptor: Suscriptor): void
  + desuscribir(tipo_evento: str, suscriptor: Suscriptor): void
  + publicar(tipo_evento: str, datos: Dict): void
}

interface Suscriptor <<Observer>> {
  {abstract} + actualizar(tipo_evento: str, datos: Dict): void
}

class NotificadorCOE <<ConcreteObserver>> {
  - bandeja: List[str]
  + actualizar(tipo_evento: str, datos: Dict): void
}

class AuditorEventosSismicos <<ConcreteObserver>> {
  - bandeja: List[str]
  + actualizar(tipo_evento: str, datos: Dict): void
}

class TableroOperacionesMapa <<ConcreteObserver>> {
  - puntos_actualizados: List[Dict]
  + actualizar(tipo_evento: str, datos: Dict): void
}

class ServicioSincronizacion <<Client>> {
  - publicador: PublicadorEventos
  + sincronizar_reporte(...)
}

ServicioSincronizacion --> PublicadorEventos : "publicar('reporte_recibido')"
PublicadorEventos o--> Suscriptor : "notifica a 0..*"

Suscriptor <|.. NotificadorCOE
Suscriptor <|.. AuditorEventosSismicos
Suscriptor <|.. TableroOperacionesMapa

@enduml
