digraph U {
  graph [rankdir=LR, nodesep=0.12, ranksep=0.35, fontname="Arial", pad=0.15];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.12,0.06"];
  edge [color="#7F7F7F", arrowhead=none];

  // Nodo raíz
  U [label="Utilidad\nSismoReporta AQP", fillcolor="#1A3A5C", fontcolor="white", color="#1A3A5C", fontsize=13];

  // Atributos de Calidad
  node [fillcolor="#C8310E", fontcolor="white", color="#C8310E"];
  R [label="Rendimiento"];
  D [label="Disponibilidad"];
  S [label="Seguridad"];
  M [label="Modificabilidad"];

  // Subcategorías
  node [fillcolor="#F4CCC3", fontcolor="black", color="#C8310E"];
  R1 [label="Ráfagas en simulacro\n(20 000 rep/h)"];
  R2 [label="Renderizado de mapa\nde calor COE"];
  D1 [label="Red celular colapsada\n(30 min sin señal)"];
  D2 [label="Caída temporal del\nbroker de colas (Redis)"];
  S1 [label="Aislamiento entre\njurisdicciones distritales"];
  S2 [label="Protección de datos\npersonales (Ley 29733)"];
  M1 [label="Nuevo canal de\ntelecomunicaciones"];
  M2 [label="Nueva jurisdicción\ndistrital"];

  // Escenarios con calificación (Importancia, Dificultad)
  node [fillcolor="#F7F7F7", color="#9A9A9A", fontcolor="black", width=6.6, fontsize=10.5];
  Q1 [label="(H,H) QA-01: 20 000 rep/h en simulacro → p95 entrega HTTP 202 ≤ 1.5 s, errores < 0.05 %"];
  Q2 [label="(H,M) QA-02: 20 000 incidentes en BD → re-renderizado de mapa de calor en COE ≤ 2.0 s"];
  Q3 [label="(H,H) QA-03: Red celular colapsada 30 min → 0 reportes perdidos en PWA; 98 % sincroniza en ≤ 3 min"];
  Q4 [label="(H,M) QA-04: Falla de broker Redis por 15 min → circuit breaker activa modo outbox; 0 reportes descartados"];
  Q5 [label="(H,M) QA-05: Operador de Cayma consulta reportes → RLS garantiza 0 fugas de datos hacia otros distritos"];
  Q6 [label="(M,L) QA-06: Tráfico interceptado → TLS 1.3 y disco cifrado garantizan 0 datos de contacto expuestos"];
  Q7 [label="(M,M) QA-07: Incorporar canal Mesh LoRa o Telegram en ≤ 2 días-persona sin alterar el núcleo"];
  Q8 [label="(M,L) QA-08: Incorporar distrito de Yura al sistema en ≤ 1 h mediante configuración sin redeploy"];

  // Conexiones del árbol
  U -> {R D S M};
  R -> R1 -> Q1;
  R -> R2 -> Q2;
  D -> D1 -> Q3;
  D -> D2 -> Q4;
  S -> S1 -> Q5;
  S -> S2 -> Q6;
  M -> M1 -> Q7;
  M -> M2 -> Q8;
}
